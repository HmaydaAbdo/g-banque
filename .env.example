# =============================================================================
# G-Banque — modèle du fichier .env (environnement unique : dev = prod)
# Copier en .env à la racine du dépôt et remplir les valeurs marquées <...>.
# .env n'est jamais versionné. Toute nouvelle variable est ajoutée ici dans le même changement.
# Lu par docker-compose.yml ; le backend refuse de démarrer si une variable manque.
# =============================================================================

# ── Base de données (MySQL 8, service "mysql" de docker-compose) ────────────
DB_HOST=mysql
DB_PORT=3306
MYSQL_DATABASE=gbanque
MYSQL_USER=gbanque_user
MYSQL_PASSWORD=<mot de passe applicatif>
MYSQL_ROOT_PASSWORD=<mot de passe root>
# Port MySQL vu par le conteneur de sauvegarde
MYSQL_PORT=3306

# ── Serveur backend ─────────────────────────────────────────────────────────
SERVER_ADRESSE=0.0.0.0
SERVER_PORT=8080
CONTEXT_PATH=/gbanque/api
# Swagger UI / OpenAPI : true pour l'activer (exposé à quiconque atteint l'API)
SWAGGER_ENABLED=false
# Origines autorisées (séparées par des virgules), ex. http://serveur,http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# ── Sessions ────────────────────────────────────────────────────────────────
# Clé de signature des jetons : 64 caractères hexadécimaux, générer avec `openssl rand -hex 32`
JWT_SECRET=<clé aléatoire>
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_HOURS=8
# true uniquement quand G-Banque est servi en HTTPS (cookies Secure)
AUTH_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Messagerie (notifications des jobs) ─────────────────────────────────────
MAIL_HOST=<serveur SMTP>
MAIL_PORT=587
MAIL_USERNAME=<compte SMTP>
MAIL_PASSWORD=<mot de passe SMTP>
MAIL_PROTOCOL=smtp
MAIL_FROM=<adresse expéditeur>
MAIL_NOTIFICATION_RECIPIENTS=<destinataires séparés par des virgules>

# ── Divers ──────────────────────────────────────────────────────────────────
TZ=Africa/Casablanca
GRAFANA_USER=<utilisateur Grafana>
GRAFANA_PASSWORD=<mot de passe Grafana>
