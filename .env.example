# Copier en .env et remplir avec les valeurs reelles de l'environnement (jamais commit .env lui-meme)

# Serveur
SERVER_ADRESSE=0.0.0.0
SERVER_PORT=8080
CONTEXT_PATH=/gBanque/api

# Base de donnees
DB_HOST=localhost
DB_PORT=3306
MYSQL_DATABASE=Gbanque
MYSQL_USER=root
MYSQL_PASSWORD=

# Auth (module auth) - generer une valeur forte et unique par environnement
JWT_SECRET=

# Swagger / OpenAPI — true en dev, false en prod (obligatoire)
SWAGGER_ENABLED=true

# Mail / SMTP (toutes obligatoires sauf MAIL_PROTOCOL, defaut "smtp")
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp
MAIL_FROM=
MAIL_NOTIFICATION_RECIPIENTS=
